# =====================================================================
# .gitattributes для проекта Unreal Engine 5 (OPD_lab4)
# Правило: БИНАРНЫЕ файлы -> Git LFS, ТЕКСТОВЫЕ -> обычный Git (с diff).
# Синтаксис LFS-строки: filter=lfs diff=lfs merge=lfs -text
#   filter=lfs  - в репозиторий кладётся указатель, сам файл - в LFS-хранилище
#   diff=lfs    - git diff не пытается показывать содержимое бинарника
#   merge=lfs   - git не пытается сливать бинарник построчно
#   -text       - никакой конвертации окончаний строк (бинарник не портится)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Текст по умолчанию: git сам определяет текстовые файлы и
#    нормализует окончания строк (в репозитории LF).
# ---------------------------------------------------------------------
* text=auto

# ---------------------------------------------------------------------
# 2. Текстовые файлы Unreal и кода — НЕ в LFS (нужен diff и merge)
# ---------------------------------------------------------------------
*.ini       text
*.uproject  text
*.uplugin   text
*.json      text
*.cpp       text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.inl       text diff=cpp
*.cs        text diff=csharp
*.py        text diff=python
*.usf       text
*.ush       text
*.md        text
*.txt       text
*.csv       text
*.xml       text

# Скрипты: хук и setup.sh обязаны иметь LF, иначе "#!/bin/sh\r"
# не запустится (в системе стоит core.autocrlf=true). setup.ps1 — CRLF.
.githooks/*  text eol=lf
*.sh         text eol=lf
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# ---------------------------------------------------------------------
# 3. Бинарные ассеты Unreal Engine — В LFS
# ---------------------------------------------------------------------
# Ассеты и карты (в т.ч. __ExternalActors__/__ExternalObjects__ при OFPA
# и *_BuiltData.uasset — это тоже .uasset)
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
# Bulk-данные и устаревшие пакеты UE
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------
# 4. Исходники арта (если появятся: импорт, SourceArt, иконки) — В LFS
# ---------------------------------------------------------------------
# Изображения и текстуры
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.dds   filter=lfs diff=lfs merge=lfs -text
*.ico   filter=lfs diff=lfs merge=lfs -text
# 3D-модели (.obj не указан: он в .gitignore из шаблона как объектный файл C++)
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.abc    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text
*.ma     filter=lfs diff=lfs merge=lfs -text
*.mb     filter=lfs diff=lfs merge=lfs -text
# Аудио
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
# Видео
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.avi   filter=lfs diff=lfs merge=lfs -text
*.bk2   filter=lfs diff=lfs merge=lfs -text
# Шрифты
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
