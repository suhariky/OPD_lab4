#!/bin/sh
# pre-commit hook for an Unreal Engine project.
# Blocks the commit if the index contains:
#   1) files from engine service folders: Saved, Intermediate, Binaries, DerivedDataCache, .vs
#   2) files larger than 50 MB that are not tracked by Git LFS (filter != lfs)
# Activation: git config core.hooksPath .githooks   (or run setup.sh / setup.ps1)

MAX_SIZE=52428800   # 50 MB in bytes
errors=0

# Staged files: Added, Copied, Modified, Renamed. quotePath=false keeps non-ASCII names readable.
files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

# Read line by line so that paths with spaces stay intact.
while IFS= read -r f; do
    [ -z "$f" ] && continue

    # 1) Service folders at any depth (Saved/..., Plugins/X/Binaries/...).
    case "/$f" in
        */Saved/*|*/Intermediate/*|*/Binaries/*|*/DerivedDataCache/*|*/.vs/*)
            echo "pre-commit: ERROR: service folder file in commit: $f"
            errors=$((errors + 1))
            continue
            ;;
    esac

    # Submodule pointers (gitlink, mode 160000) are commits, not files - skip them.
    mode=$(git ls-files -s -- "$f" | cut -d' ' -f1)
    [ "$mode" = "160000" ] && continue

    # 2) Size of the file being added (working tree; fallback to staged blob).
    if [ -f "$f" ]; then
        size=$(wc -c < "$f" | tr -d ' ')
    else
        size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    fi

    if [ "$size" -gt "$MAX_SIZE" ]; then
        filter=$(git check-attr filter -- "$f" | sed 's/.*: filter: //')
        if [ "$filter" != "lfs" ]; then
            mb=$((size / 1048576))
            echo "pre-commit: ERROR: $f is ${mb} MB (> 50 MB) and is not tracked by Git LFS (filter: $filter)"
            errors=$((errors + 1))
        fi
    fi
done <<EOF
$files
EOF

if [ "$errors" -gt 0 ]; then
    echo ""
    echo "pre-commit: commit rejected, problems found: $errors"
    echo "  - service folders: unstage with  git restore --staged <file>  (they are in .gitignore)"
    echo "  - large files: add a rule to .gitattributes, e.g.  git lfs track \"*.ext\""
    exit 1
fi

exit 0
